# Configuración del servidor
NODE_ENV=development
SERVER_PORT=3100

# Configuración de la base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment_service
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=1d

# Configuración de contratos
CONTRACT_PAYMENT_HANDLER_ADDRESS=0xYourStablecoinPaymentHandlerAddress
CONTRACT_TOKEN_SWAPPER_ADDRESS=0xYourTokenSwapperAddress
CONTRACT_HYPERBRIDGE_ADDRESS=0xYourHyperbridgeTeleportAddress
CONTRACT_NETWORK_RPC_URL=https://sepolia.infura.io/v3/your-infura-key
WALLET_PRIVATE_KEY=your-wallet-private-key
CERE_TOKEN_ADDRESS=0xYourCereTokenAddress

# Configuración de proveedores de pago
STRIPE_SECRET_KEY=your-stripe-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Configuración API Cere DDC
CERE_API_URL=https://api.cere.network
CERE_API_KEY=your-cere-api-key

# Logs
LOG_LEVEL=info

# Direcciones de contratos de stablecoins
USDC_CONTRACT_ADDRESS=0xYourUSDCTokenAddress
USDT_CONTRACT_ADDRESS=0xYourUSDTTokenAddress 