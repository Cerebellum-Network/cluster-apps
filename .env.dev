# Developer Console runtime config (apps/developer-console/src/config.ts and the
# storage, inference, billing and compute slices): Dragon 1 devnet, the values of
# the deployed devnet console's /config.js. A deployed build reads them from
# /config.js; these are the fallback for `npm run start` and a build from this file.
VITE_NETWORK=devnet
VITE_WALLET_ORIGIN=https://wallet.compute.dev.ddcdragon.com
